#!/bin/sh
# Resolve this checkout on either side of the share; never enter the VM venv.
set -eu
PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin${PATH:+:$PATH}"
export PATH
entry=$0
while [ -L "$entry" ]; do
    parent=$(CDPATH= cd -- "$(dirname -- "$entry")" && pwd -P)
    target=$(readlink "$entry")
    case "$target" in /*) entry=$target ;; *) entry=$parent/$target ;; esac
done
root=$(CDPATH= cd -- "$(dirname -- "$entry")" && pwd -P)
python="$root/.private/portable-macos-arm64-kit/python/bin/python3"
if [ ! -x "$python" ]; then
    echo "multimodel-transcription-kit: shared portable runtime is missing; build it with scripts/build_portable.py" >&2
    exit 1
fi
# macOS kills unsigned binaries on a quarantined mount (the VM's SMB share) and shows a
# malware dialog for each attempt. Refuse here instead of launching.
if [ "$(uname)" = Darwin ]; then
    mountpoint=$(df -P "$python" | awk 'NR==2 {print $6}')
    if mount | grep -F " on $mountpoint (" | grep -q quarantine; then
        echo "multimodel-transcription-kit: $mountpoint is mounted with quarantine, so macOS would block the shared runtime; run on the host" >&2
        exit 1
    fi
fi
exec "$python" -I "$root/scripts/portable_entry.py" "$@"
